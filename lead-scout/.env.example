# Lead-Scout – Einstellungen
# Diese Datei als „.env“ kopieren und ausfüllen. Die .env wird nicht ins Git-Repository übernommen.

# Google-Cloud-API-Schlüssel für „Places API (New)“ (Firmensuche) und „PageSpeed Insights API“ (Ladezeit).
# Ohne Schlüssel sucht Lead-Scout kostenlos über OpenStreetMap (weniger vollständig, keine Bewertungen).
GOOGLE_API_KEY=

# Meta Graph API für Instagram-Kennzahlen (optional).
# Token mit den Berechtigungen instagram_basic, pages_show_list, pages_read_engagement
# und die ID eures eigenen Instagram-Business-Kontos (findet „python3 leadscout.py --pruefen“).
META_ACCESS_TOKEN=
META_IG_USER_ID=
META_GRAPH_VERSION=v23.0

# Land für die Suche (DE, AT oder CH) und Sprache der Ergebnisse
LAND=DE
SPRACHE=de

# Optional: eure Website. Wird im User-Agent mitgeschickt, damit Website-Betreiber sehen, wer prüft.
KONTAKT=

# Optional: anderer Ordner für die Berichte
# BERICHTE_ORDNER=~/Documents/Lead-Scout-Berichte
